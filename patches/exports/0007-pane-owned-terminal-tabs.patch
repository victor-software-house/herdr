+    }
+    if let Some(session) = restored_agent_session {
+        terminal.set_persisted_agent_session(session);
+    }
+    match (saved.agent_name.clone(), saved_managed_agent) {
+        (Some(agent_name), Some(agent)) if preserve_agent_state => {
